<Window x:Class="UsbMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:UsbMaker.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="CP Bootable USB — COMPUTER PLUS"
        Icon="/Assets/app.ico"
        Width="1240" Height="860" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- main -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- COMPUTER PLUS shop logo (white background, rounded corners) -->
                <Image Width="64" Height="64" Source="/Assets/logo.png" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,64,64" RadiusX="14" RadiusY="14"/>
                    </Image.Clip>
                </Image>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="24" FontWeight="Bold">
                        <Run Text="CP Bootable USB"/>
                        <Run Text="  ·  COMPUTER PLUS" Foreground="{StaticResource AccentLightBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                    <TextBlock Text="Fast &amp; Reliable Windows Deployment - We Always Ready To Help You."
                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Windows 7 · 8 · 8.1 · 10 · 11  (32 + 64-bit)" HorizontalAlignment="Right" Foreground="{StaticResource AccentLightBrush}"/>
                    <TextBlock Text="BIOS + UEFI · Secure Boot ready" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT column: runs the full height of the window -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="16,16,16,0">
                        <StackPanel>
                            <!-- 1. USB drive -->
                            <Grid>
                                <TextBlock Text="1. USB Drive" Style="{StaticResource CardTitle}"/>
                                <Button Content="⟳ Refresh" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4"
                                        Command="{Binding RefreshCommand}"/>
                            </Grid>
                            <ComboBox ItemsSource="{Binding Disks}" SelectedItem="{Binding SelectedDisk}"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding DiskStatus}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                            <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0"
                                    Visibility="{Binding SelectedDisk, Converter={StaticResource NullToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedDisk.DetailsText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding SelectedDisk.WarningText}" Foreground="{StaticResource WarningBrush}"
                                               TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                                               Visibility="{Binding SelectedDisk.WarningText, Converter={StaticResource NullToVisibility}}"/>
                                </StackPanel>
                            </Border>

                            <Separator Margin="0,16,0,12" Background="{StaticResource BorderBrush}"/>

                            <!-- 2. Options -->
                            <TextBlock Text="2. Options" Style="{StaticResource CardTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Data partition (CP_WIN_DATA)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding FileSystems}" SelectedItem="{Binding SelectedFileSystem}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Boot partition (FAT32, MB)" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding BootSizes}" SelectedItem="{Binding BootPartitionSizeMb}"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox Content="Verify boot files after copying (recommended)" IsChecked="{Binding VerifyAfterCopy}" Margin="0,10,0,0"/>

                            <!-- Architecture support summary -->
                            <Border Background="{StaticResource BgBrush}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="✔ 32-bit + 64-bit Windows ISOs: supported (Windows 7 / 8 / 8.1 / 10 / 11)"
                                               Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" FontSize="12"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="ⓘ 32-bit WinPE not in payload — very old 32-bit-only CPUs cannot boot this USB (all 64-bit PCs can)."/>
                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PayloadHasX86}" Value="True">
                                                        <Setter Property="Text" Value="✔ 32-bit WinPE included — old 32-bit-only PCs can boot too (Legacy BIOS menu)."/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="WinPE boot payload folder" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PayloadPath, UpdateSourceTrigger=LostFocus}"/>
                                <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowsePayloadCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding PayloadStatus}" TextWrapping="Wrap" Margin="0,6,0,12" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PayloadOk}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 4. Create — pinned to the bottom of the left column -->
                    <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                        <StackPanel>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding CreateCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,8,0"/>
                                    <TextBlock Text="Create Bootable USB"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Erases the whole USB drive and installs CP Bootable USB."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="Update Branding Only" Command="{Binding UpdateBrandingCommand}"
                                        ToolTip="Rewrites config.json and logo on an existing CP USB without formatting. ISO files are kept."/>
                                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT column: branding editor (top) + progress & log (bottom) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="240"/>
                </Grid.RowDefinitions>

                <!-- 3. Branding -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="16,16,16,0">
                            <TextBlock Text="3. Branding &amp; Boot Screen" Style="{StaticResource CardTitle}"/>
                            <Button Content="Reset to COMPUTER PLUS defaults" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4"
                                    Command="{Binding ResetBrandingCommand}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,16,16"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Software / Brand Title" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding SoftwareName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shop / Brand Name" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding BrandName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Tagline" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Tagline, UpdateSourceTrigger=PropertyChanged}" MaxLength="150"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Phone numbers (one per line)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding PhonesText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                 Height="64" TextWrapping="NoWrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Shop Address" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                                 Height="64" TextWrapping="Wrap" MaxLength="200"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Notice / Technician Instructions (shown on the boot screen)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding Notice, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                         Height="96" TextWrapping="Wrap" MaxLength="1500"/>

                                <TextBlock Text="Developer Credit" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding DeveloperCredit, UpdateSourceTrigger=PropertyChanged}" MaxLength="100"/>

                                <!-- Logo (rounded corners; built-in = COMPUTER PLUS shop logo) -->
                                <TextBlock Text="Logo (.png / .jpg)" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Width="72" Height="72" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding LogoSourcePath, Converter={StaticResource PathToImage}}">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,72,72" RadiusX="16" RadiusY="16"/>
                                        </Image.Clip>
                                    </Image>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LogoSourcePath, TargetNullValue='COMPUTER PLUS shop logo (built-in)'}"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="Choose image…" Command="{Binding BrowseLogoCommand}"/>
                                            <Button Content="Use shop logo" Margin="8,0,0,0" Command="{Binding ClearLogoCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Theme -->
                                <TextBlock Text="Accent Colour Theme" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ThemePresetNames}" SelectedItem="{Binding SelectedThemePreset}" Width="240" HorizontalAlignment="Left"/>
                                <UniformGrid Columns="4" Margin="0,8,0,0">
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}"/>
                                            <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Surface" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Background="{Binding SurfaceColor, Converter={StaticResource HexToBrush}}"/>
                                            <TextBox Text="{Binding SurfaceColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Accent" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}"/>
                                            <TextBox Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Accent Light" Style="{StaticResource FieldLabel}"/>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="4" Margin="0,0,6,0"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    Background="{Binding AccentLightColor, Converter={StaticResource HexToBrush}}"/>
                                            <TextBox Text="{Binding AccentLightColor, UpdateSourceTrigger=PropertyChanged}" MaxLength="9"/>
                                        </DockPanel>
                                    </StackPanel>
                                </UniformGrid>

                                <!-- Mini preview of the boot-screen header -->
                                <TextBlock Text="Boot screen preview" Style="{StaticResource FieldLabel}"/>
                                <Border CornerRadius="8" Padding="14"
                                        Background="{Binding BackgroundColor, Converter={StaticResource HexToBrush}}">
                                    <Border CornerRadius="8" Padding="12"
                                            Background="{Binding SurfaceColor, Converter={StaticResource HexToBrush}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image Width="56" Height="56" Stretch="UniformToFill" VerticalAlignment="Top"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding LogoSourcePath, Converter={StaticResource PathToImage}}">
                                                <Image.Clip>
                                                    <RectangleGeometry Rect="0,0,56,56" RadiusX="12" RadiusY="12"/>
                                                </Image.Clip>
                                            </Image>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding SoftwareName}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                                <TextBlock Text="{Binding BrandName}" FontWeight="SemiBold"
                                                           Foreground="{Binding AccentLightColor, Converter={StaticResource HexToBrush}}"/>
                                                <TextBlock Text="{Binding Tagline}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                                <Border CornerRadius="6" Padding="12,6" HorizontalAlignment="Left"
                                                        Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}">
                                                    <TextBlock Text="Install Windows" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Progress + log (right side, under branding) -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Text="{Binding ProgressValue, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentLightBrush}"
                                           VerticalAlignment="Center" Margin="12,0,12,0"/>
                                <Button Content="Open log folder" Padding="10,3" Command="{Binding OpenLogFolderCommand}"/>
                            </StackPanel>
                        </Grid>
                        <ProgressBar Grid.Row="1" Value="{Binding ProgressValue}" Maximum="100" Margin="0,8,0,8"/>
                        <ListBox x:Name="LogList" Grid.Row="2" ItemsSource="{Binding Logs}" Background="{StaticResource BgBrush}"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="4,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}">
                                        <Run Text="{Binding TimeText, Mode=OneWay}" Foreground="#64748B"/>
                                        <Run Text="  "/>
                                        <Run Text="{Binding Message, Mode=OneWay}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= FOOTER ================= -->
        <Grid Grid.Row="2" Margin="2,10,2,0">
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12">
                <Run Text="Developed by MD AMZAD HOSSAIN RONI" Foreground="{StaticResource AccentLightBrush}"/>
                <Run Text="  ·  COMPUTER PLUS, Fokir Plaza, Ground Floor, Shop No #04, Bera, Pabna"/>
            </TextBlock>
            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="☎ +8801754 614 614  |  +8801913 354 321"/>
        </Grid>
    </Grid>
</Window>
