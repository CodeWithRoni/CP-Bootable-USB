<Application x:Class="UsbMaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:UsbMaker"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkSlate.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:HexToBrushConverter x:Key="HexToBrush"/>
            <local:PathToImageConverter x:Key="PathToImage"/>
            <local:NullToVisibilityConverter x:Key="NullToVisibility"/>
            <local:InverseBoolConverter x:Key="InverseBool"/>
            <local:LogLevelToBrushConverter x:Key="LogLevelToBrush"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
