<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>UsbMaker</RootNamespace>
    <AssemblyName>UsbMaker</AssemblyName>
    <AssemblyTitle>CP Bootable USB - USB Creator</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- COMPUTER PLUS shop icon: used for the .exe file, title bar and taskbar. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Portable single-file build: `dotnet publish -c Release` produces ONE UsbMaker.exe that runs on any
    Windows 10/11 x64 PC without installing .NET.
    • ReadyToRun pre-compiles the code → much faster start.
    • No single-file compression → no unpacking delay when the exe is opened.
  -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CP.Shared\CP.Shared.csproj" />
  </ItemGroup>

  <!-- Shop logo + icon: WPF resources for the UI, and an embedded copy of the logo that is written to the USB. -->
  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <EmbeddedResource Include="Assets\logo.png" LogicalName="CP.DefaultLogo.png" />
  </ItemGroup>

  <!-- WinPE boot payload produced by build\Build-WinPE.ps1 (Phase 3). Copied next to UsbMaker.exe for local builds only. -->
  <ItemGroup>
    <None Update="Payload\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
