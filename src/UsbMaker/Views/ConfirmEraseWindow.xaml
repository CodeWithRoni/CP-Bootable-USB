<Window x:Class="UsbMaker.Views.ConfirmEraseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm — all data will be erased"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13">
    <Border Margin="16" Style="{StaticResource Card}" BorderBrush="{StaticResource DangerBrush}">
        <StackPanel>
            <TextBlock Text="⚠  ALL DATA ON THIS DRIVE WILL BE ERASED" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource DangerBrush}"/>
            <TextBlock x:Name="DiskText" FontFamily="Consolas" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="LargeWarning" Visibility="Collapsed" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                       Text="This disk is larger than 256 GB. External hard disks are often backup drives — double-check that this is really the USB flash drive you want to erase."/>
            <TextBlock x:Name="PromptText" Margin="0,14,0,6" TextWrapping="Wrap"/>
            <TextBox x:Name="ConfirmBox" TextChanged="ConfirmBox_TextChanged" FontSize="16" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" IsCancel="True" Width="100" Margin="0,0,8,0"/>
                <Button x:Name="EraseButton" Content="Erase &amp; Create" Width="140" IsEnabled="False"
                        Style="{StaticResource DangerButton}" Click="Erase_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
