<Window x:Class="BootLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BootLauncher"
        Title="CP Bootable USB"
        Icon="/Assets/app.ico"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <!-- Designed at 1280×800 and scaled to the screen, so it fits 1024×768 (Legacy BIOS) up to 4K. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1280" Height="800">

            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="390"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===================== LEFT: branding + info ===================== -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Logo + names -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Width="84" Height="84" Source="{Binding Logo}" Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,84,84" RadiusX="18" RadiusY="18"/>
                                </Image.Clip>
                            </Image>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SoftwareName}" FontSize="25" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BrandName}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentLightBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding Tagline}" Style="{StaticResource Muted}" FontStyle="Italic"
                                   FontSize="13.5" Margin="0,12,0,14"/>

                        <!-- Contact -->
                        <Border Grid.Row="2" Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="CONTACT &amp; SUPPORT" Style="{StaticResource SectionTitle}" FontSize="11.5"/>
                                <ItemsControl ItemsSource="{Binding Phones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentLightBrush}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding}" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Address}" Style="{StaticResource Muted}" Margin="0,6,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Notice -->
                        <Border Grid.Row="3" Margin="0,12,0,12" CornerRadius="10" Padding="14,10"
                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Background="{DynamicResource BgBrush}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="NOTICE" Style="{StaticResource SectionTitle}" FontSize="11.5"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="13.5" LineHeight="20"/>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- System info -->
                        <Border Grid.Row="4" Background="{DynamicResource BgBrush}" CornerRadius="10" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="THIS PC" Style="{StaticResource SectionTitle}" FontSize="11.5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="86"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="CPU" Style="{StaticResource Muted}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Hardware.CpuName}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="1" Text="RAM" Style="{StaticResource Muted}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hardware.RamText}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="2" Text="Boot mode" Style="{StaticResource Muted}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Hardware.BootModeText}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentLightBrush}"/>
                                    <TextBlock Grid.Row="3" Text="Secure Boot" Style="{StaticResource Muted}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Hardware.SecureBootText}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="4" Text="Running" Style="{StaticResource Muted}" FontSize="12.5"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Hardware.EnvironmentText}" FontSize="12.5"/>
                                </Grid>
                                <TextBlock Text="Disks" Style="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,2"/>
                                <ItemsControl ItemsSource="{Binding Disks}" MaxHeight="64">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ShortText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="5" Text="{Binding DeveloperCredit}" Margin="0,12,0,0" FontSize="12.5"
                                   Foreground="{DynamicResource AccentLightBrush}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ===================== RIGHT: ISO selection + install ===================== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="4,4,4,14">
                        <StackPanel>
                            <TextBlock Text="Install Windows" FontSize="28" FontWeight="Bold"/>
                            <TextBlock Text="1. Select an ISO   ·   2. Choose the edition   ·   3. Click Install Windows"
                                       Style="{StaticResource Muted}" FontSize="14"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource Badge}" BorderBrush="{DynamicResource WarningBrush}"
                                Visibility="{Binding Hardware.IsWinPE, Converter={StaticResource VisibleIf}, ConverterParameter=Invert}">
                            <TextBlock Text="TEST MODE (not booted from USB)" Foreground="{DynamicResource WarningBrush}" FontSize="12"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="420"/>
                        </Grid.ColumnDefinitions>

                        <!-- ISO list -->
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="WINDOWS ISO FILES" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding IsoStatus}" Style="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"
                                               TextWrapping="NoWrap"/>
                                </Grid>
                                <Grid>
                                    <ListBox Style="{StaticResource CardList}" ItemsSource="{Binding Isos}" SelectedItem="{Binding SelectedIso}"
                                             IsEnabled="{Binding OverlayVisible, Converter={StaticResource InverseBool}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- disc icon -->
                                                    <Grid Width="40" Height="40" VerticalAlignment="Center">
                                                        <Ellipse Fill="{DynamicResource AccentGradient}"/>
                                                        <Ellipse Width="12" Height="12" Fill="{DynamicResource BgBrush}"/>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                        <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Border Style="{StaticResource Badge}">
                                                                <TextBlock Text="{Binding GuessText}" FontSize="11.5" Foreground="{DynamicResource AccentLightBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource BorderBrush}">
                                                                <TextBlock Text="{Binding SizeText}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Location}" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="{Binding IsoStatus}" Style="{StaticResource Muted}" FontSize="15" TextAlignment="Center"
                                               VerticalAlignment="Center" Margin="30"
                                               Visibility="{Binding Isos.Count, Converter={StaticResource VisibleIf}, ConverterParameter=Invert}"/>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <!-- Edition + install -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="WINDOWS EDITION" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock Text="{Binding AnalysisText}" TextWrapping="Wrap" FontSize="13.5"/>
                                    <ProgressBar IsIndeterminate="True" Height="6" Margin="0,8,0,0"
                                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}"/>
                                </StackPanel>

                                <ListBox Grid.Row="1" Style="{StaticResource CardList}" ItemsSource="{Binding Editions}"
                                         SelectedItem="{Binding SelectedEdition}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Style="{StaticResource Badge}">
                                                        <TextBlock Text="{Binding Arch}" FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource BorderBrush}">
                                                        <TextBlock Text="{Binding EngineText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" BorderBrush="{DynamicResource DangerBrush}"
                                                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="Not supported here" FontSize="11" Foreground="{DynamicResource DangerBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- compatibility / warning -->
                                <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,8,0,0" BorderThickness="1"
                                        Visibility="{Binding CompatibilityText, Converter={StaticResource VisibleIf}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CompatibilityIsError}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CompatibilityText}" TextWrapping="Wrap" FontSize="12.5"/>
                                </Border>

                                <!-- Windows 11 bypass -->
                                <StackPanel Grid.Row="3" Margin="0,10,0,0" Visibility="{Binding ShowBypass, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="WINDOWS 11 REQUIREMENT BYPASS" Style="{StaticResource SectionTitle}" FontSize="11.5" Margin="0,0,0,2"/>
                                    <WrapPanel>
                                        <CheckBox Content="TPM 2.0" IsChecked="{Binding BypassTpm}"/>
                                        <CheckBox Content="Secure Boot" IsChecked="{Binding BypassSecureBoot}"/>
                                        <CheckBox Content="RAM" IsChecked="{Binding BypassRam}"/>
                                        <CheckBox Content="CPU" IsChecked="{Binding BypassCpu}"/>
                                        <CheckBox Content="Storage" IsChecked="{Binding BypassStorage}"/>
                                    </WrapPanel>
                                </StackPanel>

                                <Button Grid.Row="4" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                                        Content="Install Windows" Command="{Binding InstallCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Utility bar -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="12,10">
                        <Grid>
                            <TextBlock Text="Tip: you can keep many ISO files in the ISO folder of the USB drive."
                                       Style="{StaticResource Muted}" FontSize="12.5" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Refresh Drives" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                                <Button Content="Command Prompt" Command="{Binding OpenCmdCommand}" Margin="0,0,8,0"
                                        Visibility="{Binding ShowCommandPrompt, Converter={StaticResource BoolToVisibility}}"/>
                                <Button Content="Restart" Command="{Binding RebootCommand}" Margin="0,0,8,0"/>
                                <Button Content="Shut Down" Command="{Binding ShutdownCommand}" Style="{StaticResource DangerButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===================== Overlay (progress / results) ===================== -->
            <Grid Visibility="{Binding OverlayVisible, Converter={StaticResource BoolToVisibility}}">
                <Rectangle Fill="#CC0B1220"/>
                <Border Style="{StaticResource Card}" Width="720" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28">
                    <StackPanel>
                        <TextBlock Text="{Binding OverlayTitle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverlayIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding OverlayMessage}" TextWrapping="Wrap" FontSize="15" Margin="0,10,0,14"/>
                        <ProgressBar Value="{Binding OverlayProgress}" Maximum="100" IsIndeterminate="{Binding OverlayIndeterminate}"
                                     Visibility="{Binding OverlayIsError, Converter={StaticResource VisibleIf}, ConverterParameter=Invert}"/>
                        <ItemsControl ItemsSource="{Binding OverlayLog}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Content="{Binding RebootButtonText}" Command="{Binding RebootNowCommand}" Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,10,0" Visibility="{Binding OverlayShowReboot, Converter={StaticResource BoolToVisibility}}"/>
                            <Button Content="Close" Command="{Binding CloseOverlayCommand}"
                                    Visibility="{Binding OverlayCanClose, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
